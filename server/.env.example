# Server Environment Variables

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Multiple providers (comma separated) - Supported: max, isracard, amex, hapoalim, leumi, pepper
CARD_PROVIDERS=max,isracard

# Isracard/Amex (require ID, card 6 digits, password)
ISRACARD_ID=your_isracard_id_number
ISRACARD_CARD6DIGITS=123456
ISRACARD_PASSWORD=your_password

AMEX_ID=your_amex_id_number
AMEX_CARD6DIGITS=123456
AMEX_PASSWORD=your_password

# Max (username/password)
MAX_USERNAME=your_max_username
MAX_PASSWORD=your_max_password

# Hapoalim (username/password)
HAPOALIM_USERNAME=your_hapoalim_username
HAPOALIM_PASSWORD=your_hapoalim_password

# Leumi (username/password)
LEUMI_USERNAME=your_leumi_username
LEUMI_PASSWORD=your_leumi_password

# Pepper (username/password)
PEPPER_USERNAME=your_pepper_username
PEPPER_PASSWORD=your_pepper_password

# Fallback credentials
CARD_USERNAME=your_default_username
CARD_PASSWORD=your_default_password
